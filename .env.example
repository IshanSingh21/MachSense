# ==============================================================================
# MachSense Backend Environment Configuration Template
# Copy to .env for local runtime overrides (never commit actual .env)
# ==============================================================================

# Runtime Environment (development | staging | production)
MACHSENSE_ENV=production

# Server Host & Port (Render dynamically assigns PORT at runtime)
HOST=0.0.0.0
PORT=8000

# Worker concurrency (keep 1 on Render Free Tier with 512MB RAM)
WEB_CONCURRENCY=1

# CORS Allowed Origins
# For local development:
# MACHSENSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For production deployment on Render (replace with your actual Vercel domain):
# MACHSENSE_CORS_ORIGINS=https://your-machsense-frontend.vercel.app,http://localhost:3000
MACHSENSE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Python Module Path (enables importing from ./src)
PYTHONPATH=./src

# Custom Model Directory (defaults to 'models')
MACHSENSE_MODELS_DIR=models
