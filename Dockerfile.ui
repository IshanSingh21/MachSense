# ==============================================================================
# MachSense Streamlit UI Dashboard Container
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src:${PYTHONPATH}" \
    MACHSENSE_ENV=production \
    MACHSENSE_API_URL="http://api:8000" \
    PORT=8501

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -U pip && \
    pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY configs/ ./configs/
COPY models/ ./models/
COPY .streamlit/ ./.streamlit/
COPY pyproject.toml .

RUN useradd -m -u 1000 machsense && \
    mkdir -p /app/logs && \
    chown -R machsense:machsense /app

USER machsense

EXPOSE 8501

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/machsense/ui/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
